# Copy to .env (never commit .env). All values are required unless marked optional.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token-or-service-principal-token>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
# Microsoft Entra ID sign-in. One app registration (Entra admin center > App registrations > New):
#   - Expose an API: Application ID URI api://<client-id>, add the delegated scope 'access_as_user'
#   - Authentication > Add a platform > Single-page application, redirect URIs:
#       http://127.0.0.1:8000/  and  http://127.0.0.1:8000/docs/oauth2-redirect
#   - Manifest: "requestedAccessTokenVersion": 2 (optional; v1.0 tokens are accepted too)
# Callers send 'Authorization: Bearer <access token for api://<client-id>/access_as_user>'.
ENTRA_TENANT_ID=<directory-tenant-id>
ENTRA_API_CLIENT_ID=<application-client-id>
# Optional (defaults shown / derived)
# ENTRA_API_AUDIENCE=api://<application-client-id>
# ENTRA_REQUIRED_SCOPE=access_as_user
# ENTRA_UI_CLIENT_ID=<application-client-id>      # a separate SPA registration, if you use one
# ENTRA_REQUIRED_APP_ROLE=SupplyChain.Read         # app role that lets app-only (client credentials) callers in
# Optional (defaults shown)
DATABRICKS_CATALOG=data2026acc123456
DATABRICKS_SCHEMA=team4
API_HOST=127.0.0.1
API_PORT=8000
# Assistant LLM: same .env values as the instructor's demos. AzureChatOpenAI(model=AZURE_OPENAI_DEPLOYMENT_NAME);
# langchain-openai reads the endpoint, key and API version from the same .env.
AZURE_OPENAI_DEPLOYMENT_NAME=<chat-deployment>
