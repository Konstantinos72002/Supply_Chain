# Copy to .env (never commit .env). All values are required unless marked optional.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token-or-service-principal-token>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
# Key that clients (and later the LangGraph agents) send in the X-API-Key header
API_KEY=<long-random-string>
# Optional (defaults shown)
DATABRICKS_CATALOG=data2026acc123456
DATABRICKS_SCHEMA=team4
API_HOST=127.0.0.1
API_PORT=8000
# Assistant LLM: same .env values as the instructor's demos. AzureChatOpenAI(model=AZURE_OPENAI_DEPLOYMENT_NAME);
# langchain-openai reads the endpoint, key and API version from the same .env.
AZURE_OPENAI_DEPLOYMENT_NAME=<chat-deployment>
